# Copy to deploy/context_ir.env and fill locally. Never commit the real file.
GITEE_AI_API_KEY=
YIWU_VLM_BASE_URL=http://127.0.0.1:9012
YIWU_VLM_MODEL=Qwen3-VL-32B-Instruct
YIWU_VLM_API_KEY_ENV=GITEE_AI_API_KEY
CONTEXT_IR_VLM_PROVIDER=local-qwen3-vl-32b
CONTEXT_IR_VIDEO_FRAME_COUNT=6
CONTEXT_IR_VIDEO_FPS=2
CONTEXT_IR_VIDEO_MAX_FRAMES=256
CONTEXT_IR_VLM_POLL_INTERVAL=1
CONTEXT_IR_VLM_TIMEOUT_SECONDS=1800
CONTEXT_IR_VLM_OUTPUT_DIR=/home/mx/shenxing/minimax-H3-context-IR/outputs/qwen3-vl-32b

# Select the Codex reasoning provider: deepseek_litellm (default),
# deepseek (official API), or glm.
CONTEXT_IR_LLM_PROVIDER=deepseek_litellm
CONTEXT_IR_LLM_STREAM_IDLE_TIMEOUT_MS=600000

# Default: DeepSeek V4 Flash through the internal LiteLLM Responses API.
# When omitted, the launch scripts reuse OPENAI_API_KEY for backward
# compatibility with existing LiteLLM deployments.
LITELLM_API_KEY=
DEEPSEEK_LITELLM_RESPONSES_BASE_URL=http://litellm-poc.pgw.metax-tech.com/v1
DEEPSEEK_LITELLM_HTTP_HOST=
DEEPSEEK_LITELLM_MODEL=deepseek-v4-flash
DEEPSEEK_LITELLM_PROVIDER_ID=deepseek_litellm

# GLM through the remote LiteLLM Responses API.
OPENAI_API_KEY=
GLM_RESPONSES_BASE_URL=http://127.0.0.1:38041/v1
GLM_HTTP_HOST=litellm-poc.pgw.metax-tech.com
GLM_MODEL=GLM-5.2
GLM_PROVIDER_ID=glm

# Optional: DeepSeek official Responses API. Select with
# CONTEXT_IR_LLM_PROVIDER=deepseek. Keep the real key only in context_ir.env.
DEEPSEEK_API_KEY=
DEEPSEEK_RESPONSES_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_PROVIDER_ID=deepseek
